# Copy this file to .env and edit it:   cp .env.example .env     (Windows: copy .env.example .env)
# .env is private. It is in .gitignore, so it never gets committed.
# On Windows with PostgreSQL installed, scripts\setup_windows.ps1 does all of this for you.

# Where Postgres lives. The default matches docker-compose.yml and db/init.sql.
# If your PostgreSQL is not on port 5432, change the number in both lines.
DATABASE_URL=postgresql://rectifi:rectifi_dev@localhost:5432/rectifi
TEST_DATABASE_URL=postgresql://rectifi:rectifi_dev@localhost:5432/rectifi_test

# Which model powers the Ask page. The agent needs a model that supports TOOL CALLING.
#   ollama         free, private, runs on your laptop (needs RAM)
#   openrouter     models whose id ends in ":free" cost nothing: about 20 requests a minute, 50 a day
#   huggingface    NOT free on a free account ($0 credit). Needs PRO or bought credits.
#   deepseek       paid, cheap
#   openai_compat  anything else that speaks the OpenAI API (Groq, LM Studio, ...)
LLM_PROVIDER=ollama

# Ollama (LLM_PROVIDER=ollama)
# `python scripts/dev.py ollama-setup` downloads a set of models that fits this laptop's RAM and prints the lines below for you.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
# Windows tip: if the app says Ollama is not reachable, use the numeric address (localhost can resolve to ::1 and miss it):
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Context window. Ollama's own default is small and silently drops the tool list, so Rectifi asks for 8192.
OLLAMA_NUM_CTX=8192
# Seconds to wait for one reply (a laptop CPU can take a minute to load a model) and how long a model stays in memory.
OLLAMA_TIMEOUT=120
OLLAMA_KEEP_ALIVE=30m

# Which model does which job. Empty = the chat model (OLLAMA_MODEL). Small and fast is fine for sorting and grading.
RECTIFI_MODEL_CHAT=
RECTIFI_MODEL_CLASSIFY=
RECTIFI_MODEL_CODE=
RECTIFI_MODEL_GRADE=
# The embedding model for the library (ollama pull nomic-embed-text). The prefixes are what that model expects; 0 switches them off.
RECTIFI_EMBED_MODEL=nomic-embed-text
# RECTIFI_EMBED_PREFIXES=1

# Sorting imports into categories. The fixed rules always run. The model pass runs after the import (set 0 to switch it off).
# A model answer at or above APPLY_MIN percent is stored; between SUGGEST_MIN and APPLY_MIN it is only suggested.
# RECTIFI_AUTO_CLASSIFY=1
# RECTIFI_CLASSIFY_APPLY_MIN=80
# RECTIFI_CLASSIFY_SUGGEST_MIN=50
# RECTIFI_CLASSIFY_BATCH=12

# Chart code written by the model runs in a sandboxed child process.
# RECTIFI_CHART_ATTEMPTS=3
# RECTIFI_CHART_TIMEOUT=30
# RECTIFI_CHART_MEMORY_MB=512
# Plotly charts (needs plotly installed; not built as a default):
# RECTIFI_CHARTS_PLOTLY=0

# Library (CRAG and Self-RAG). Web search sends the question to the internet, so it is off. It also needs `pip install ddgs`.
# RECTIFI_WEB_SEARCH=1
# RECTIFI_RAG_REFINE_TAU=0.2

# OpenRouter (LLM_PROVIDER=openrouter). Key: openrouter.ai/keys
# Pick the model with:  python scripts/dev.py free-models   (the list changes often)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Hugging Face (LLM_PROVIDER=huggingface). Needs PRO or purchased credits; free accounts get $0.
# Token: huggingface.co/settings/tokens, fine-grained, "Make calls to Inference Providers".
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V3.1:cheapest

# DeepSeek (LLM_PROVIDER=deepseek). Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Any OpenAI-compatible service (LLM_PROVIDER=openai_compat). Example for Groq:
#   OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Phone SMS auto-capture (OFF by default). Your phone forwards bank SMS to this laptop; nothing can read SMS from a number.
# Turning it on makes `python scripts/dev.py up` also start a small web server, protected by a device token you create on
# the Phone page. It listens on THIS LAPTOP ONLY (127.0.0.1); your phone reaches it through Tailscale Serve:
# `python scripts/dev.py tailscale`. Read README, "Use Rectifi on your phone" and "Auto-capture bank SMS from your phone".
#   RECTIFI_SMS_GATEWAY=1   start it together with the app (or run it alone with: python scripts/dev.py phone)
#   RECTIFI_SMS_PORT=8765   the port the phone sends to
#   RECTIFI_SMS_HOST=127.0.0.1   who may connect. 127.0.0.1 = this laptop only (safe default).
#                                0.0.0.0 = everyone on your Wi-Fi: advanced, no HTTPS, the token is the only lock. Prefer Tailscale.
RECTIFI_SMS_GATEWAY=0
RECTIFI_SMS_PORT=8765
RECTIFI_SMS_HOST=127.0.0.1

# The web app (all optional)
# Only this Tailscale login may open the app through Tailscale Serve (a browser on the laptop is always let in):
# RECTIFI_TAILSCALE_USER=you@example.com
# Names the app answers to (the default is shown). A request for another name is refused:
# RECTIFI_ALLOWED_HOSTS=localhost,127.0.0.1,::1,*.ts.net
# Extra web addresses allowed to make changes, comma separated (normally empty):
# RECTIFI_ALLOWED_ORIGINS=

# Phone alerts (Web Push). Optional: Rectifi makes its own key the first time you open Alerts, Delivery, and saves it in
# the .rectifi folder (not committed). You only set these if you want to control the key yourself.
#   RECTIFI_VAPID_PRIVATE_KEY  the "ID card" Rectifi shows to your phone's push service so it knows the alert is really from
#                              your laptop. 32 random bytes written in base64url. Keep it secret. If it changes, every phone
#                              must press "Turn on phone alerts" again. Empty = use the file in .rectifi.
#   RECTIFI_VAPID_SUB          a contact address the push service may use if something is wrong, like mailto:you@example.com
#                              or https://your-name.tailnet.ts.net. Empty = Rectifi uses your own https address.
# RECTIFI_VAPID_PRIVATE_KEY=
# RECTIFI_VAPID_SUB=

# Hosting (docs/HOSTING.md). Running on your own laptop needs none of these.
# A login is required when RECTIFI_PUBLIC=1 or the app listens on anything but this laptop. Make the hash with:
#   python scripts/dev.py set-password        (it prints both lines; keep the single quotes around the hash)
# RECTIFI_PUBLIC=0
# RECTIFI_PASSWORD_HASH=
# RECTIFI_SESSION_SECRET=
#
# Several people on one server (multi-user mode). Leave it off on your laptop. Only for a server (docs/HOSTING.md):
#   RECTIFI_MULTIUSER=1   invite sign-up, one account per person. Streamlit and the MCP server refuse to run. It needs
#                         RECTIFI_SESSION_SECRET (32+ characters, `openssl rand -hex 32`); RECTIFI_PASSWORD_HASH is ignored.
# RECTIFI_MULTIUSER=
# On a server the app logs in as the plain role `rectifi` (RECTIFI_DB_PASSWORD, set in .env.deploy), never as `postgres`.

# Copy this file to .env and edit it:   cp .env.example .env     (Windows: copy .env.example .env)
# .env is private. It is in .gitignore, so it never gets committed.
# On Windows with PostgreSQL installed, scripts\setup_windows.ps1 does all of this for you.

# Where Postgres lives. The default matches docker-compose.yml and db/init.sql.
# If your PostgreSQL is not on port 5432, change the number in both lines.
DATABASE_URL=postgresql://rectifi:rectifi_dev@localhost:5432/rectifi
TEST_DATABASE_URL=postgresql://rectifi:rectifi_dev@localhost:5432/rectifi_test

# Which model powers the Ask page. The agent needs a model that supports TOOL CALLING.
#   ollama         free, private, runs on your laptop (needs RAM)
#   openrouter     models whose id ends in ":free" cost nothing: about 20 requests a minute, 50 a day
#   huggingface    NOT free on a free account ($0 credit). Needs PRO or bought credits.
#   deepseek       paid, cheap
#   openai_compat  anything else that speaks the OpenAI API (Groq, LM Studio, ...)
LLM_PROVIDER=ollama

# Ollama (LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# OpenRouter (LLM_PROVIDER=openrouter). Key: openrouter.ai/keys
# Pick the model with:  python scripts/dev.py free-models   (the list changes often)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Hugging Face (LLM_PROVIDER=huggingface). Needs PRO or purchased credits; free accounts get $0.
# Token: huggingface.co/settings/tokens, fine-grained, "Make calls to Inference Providers".
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V3.1:cheapest

# DeepSeek (LLM_PROVIDER=deepseek). Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Any OpenAI-compatible service (LLM_PROVIDER=openai_compat). Example for Groq:
#   OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Phone SMS auto-capture (OFF by default). Your phone forwards bank SMS to this laptop; nothing can read SMS from a number.
# Turning it on makes `python scripts/dev.py up` also start a small web server, protected by a device token you create on
# the Phone page. It listens on THIS LAPTOP ONLY (127.0.0.1); your phone reaches it through Tailscale Serve:
# `python scripts/dev.py tailscale`. Read README, "Use Rectifi on your phone" and "Auto-capture bank SMS from your phone".
#   RECTIFI_SMS_GATEWAY=1   start it together with the app (or run it alone with: python scripts/dev.py phone)
#   RECTIFI_SMS_PORT=8765   the port the phone sends to
#   RECTIFI_SMS_HOST=127.0.0.1   who may connect. 127.0.0.1 = this laptop only (safe default).
#                                0.0.0.0 = everyone on your Wi-Fi: advanced, no HTTPS, the token is the only lock. Prefer Tailscale.
RECTIFI_SMS_GATEWAY=0
RECTIFI_SMS_PORT=8765
RECTIFI_SMS_HOST=127.0.0.1

# The web app (all optional)
# Only this Tailscale login may open the app through Tailscale Serve (a browser on the laptop is always let in):
# RECTIFI_TAILSCALE_USER=you@example.com
# Names the app answers to (the default is shown). A request for another name is refused:
# RECTIFI_ALLOWED_HOSTS=localhost,127.0.0.1,::1,*.ts.net
# Extra web addresses allowed to make changes, comma separated (normally empty):
# RECTIFI_ALLOWED_ORIGINS=

# Settings for running Rectifi on a server. Copy this file to .env.deploy and fill it in:
#   cp .env.deploy.example .env.deploy
# .env.deploy is private. Never commit it, never paste it into a chat. Check it with:
#   python scripts/dev.py deploy-check
# Full guide: docs/HOSTING.md

# The address of this server on your tailnet, from `tailscale status` or the Tailscale admin page.
# Looks like  rectifi.tail1a2b3c.ts.net  (no https://, no slash).
RECTIFI_HOSTNAME=rectifi.your-tailnet.ts.net

# Password for the database SUPERUSER (postgres) inside Docker: set-up and backups only. Letters and numbers only.
# Make one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Password for the app's own database login (rectifi), a plain role that cannot skip the privacy checks between people.
# A different one, same rules. Make one:  openssl rand -hex 24
RECTIFI_DB_PASSWORD=

# Who may use this server.
#   (empty)  one person, one password (RECTIFI_PASSWORD_HASH below).
#   1        several people, each with their own account and an invite code (docs/HOSTING.md, "Invite people").
#            Then RECTIFI_PASSWORD_HASH is ignored, and RECTIFI_SESSION_SECRET (32+ characters) is the one login setting you need.
#            Streamlit and the MCP server refuse to run in this mode.
RECTIFI_MULTIUSER=

# One person: do not type the next two lines by hand. Run  python scripts/dev.py set-password --print
# and paste the two lines it prints over them. (Keep the single quotes around the hash.)
# Several people: leave the hash empty and make the secret yourself:  openssl rand -hex 32
RECTIFI_PASSWORD_HASH=
RECTIFI_SESSION_SECRET=

# The phone SMS gateway on the server (only runs when you start compose with  --profile gateway ; see docs/HOSTING.md).
# Inside the container it listens on port 8765; compose publishes that on 127.0.0.1 only. Tailscale Funnel on 8443 is the way in.
# Nothing to set here for the gateway itself: the device token (Phone page in the app) is its lock.
# RECTIFI_SMS_PORT=8765

# Optional ---------------------------------------------------------------------------------------------------------
# Where the daily database copies go on the server.
# BACKUP_DIR=/var/backups/rectifi
# Ollama image version. Check hub.docker.com/r/ollama/ollama/tags before you change it.
# OLLAMA_VERSION=0.12.11
# Other models (they must be pulled into the ollama volume first: docker compose ... run --rm ollama-pull)
# RECTIFI_MODEL_CHAT=qwen2.5:3b
# RECTIFI_MODEL_CLASSIFY=qwen2.5:3b
# RECTIFI_MODEL_CODE=qwen2.5-coder:3b
# RECTIFI_MODEL_GRADE=qwen2.5:3b
# RECTIFI_EMBED_MODEL=nomic-embed-text

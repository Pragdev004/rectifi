# Settings for running Rectifi on a server. Copy this file to .env.deploy and fill it in:
#   cp .env.deploy.example .env.deploy
# .env.deploy is private. Never commit it, never paste it into a chat. Check it with:
#   python scripts/dev.py deploy-check
# Full guide: docs/HOSTING.md

# The address of this server on your tailnet, from `tailscale status` or the Tailscale admin page.
# Looks like  rectifi.tail1a2b3c.ts.net  (no https://, no slash).
RECTIFI_HOSTNAME=rectifi.your-tailnet.ts.net

# Password for the database inside Docker. Letters and numbers only. Make one:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Your Rectifi login. Do not type these by hand: run  python scripts/dev.py set-password --print
# and paste the two lines it prints over the two lines below. (Keep the single quotes around the hash.)
RECTIFI_PASSWORD_HASH=
RECTIFI_SESSION_SECRET=

# Optional ---------------------------------------------------------------------------------------------------------
# Where the daily database copies go on the server.
# BACKUP_DIR=/var/backups/rectifi
# Ollama image version. Check hub.docker.com/r/ollama/ollama/tags before you change it.
# OLLAMA_VERSION=0.12.11
# Other models (they must be pulled into the ollama volume first: docker compose ... run --rm ollama-pull)
# RECTIFI_MODEL_CHAT=qwen2.5:3b
# RECTIFI_MODEL_CLASSIFY=qwen2.5:3b
# RECTIFI_MODEL_CODE=qwen2.5-coder:3b
# RECTIFI_MODEL_GRADE=qwen2.5:3b
# RECTIFI_EMBED_MODEL=nomic-embed-text
